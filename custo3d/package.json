{
  "name": "custo3d",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "npm install && npx expo install --fix",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "typecheck:logic": "tsc -p tsconfig.logic.json"
  },
  "dependencies": {
    "@expo/vector-icons": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
