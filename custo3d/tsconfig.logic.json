{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/types.ts", "src/constants.ts", "src/lib/**/*.ts", "src/store/createStore.ts", "tests/**/*.ts"]
}
